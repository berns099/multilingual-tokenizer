# Virtual environments: thousands of platform-specific files, useless to others.
.venv/
venv/
.env

# Byte-compiled
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# Downloaded data. Re-downloadable, potentially gigabytes, and FLORES is a
# gated dataset whose terms generally prohibit redistribution, so it must not
# be pushed to a shared repo.
/data/

# Model checkpoints
/checkpoints/
*.safetensors
*.bin

# macOS
.DS_Store

# Held back for now. Stays on local disk; remove this line when the team wants
# a README in the repo.
/README.md

# results/ IS committed on purpose: the survey parquet and the figures are
# small, and committing them means anyone can redraw a plot or check a number
# in the report without re-running the survey. Only oversized artifacts are
# excluded.
results/**/*.pt
results/**/*.ckpt

# Extended tokenizers are ~11 MB each; regenerate with `python -m tokpremium.vocab.run`.
# sweep.csv, new_merges.json and decomposition.json stay committed.
results/vocab/**/tokenizer.json
/checkpoints
/data
/.venv
